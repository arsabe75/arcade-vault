{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-write.js\"",
            "timeout": 120,
            "statusMessage": "Prettier + ESLint..."
          }
        ]
      }
    ]
  }
}
